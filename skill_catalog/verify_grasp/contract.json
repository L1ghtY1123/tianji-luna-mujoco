{
  "id": "verify_grasp",
  "description": "Lift 后先读执行臂实测夹爪位置。全开为空抓，中间开度为持物。仅全闭时采集该臂腕图，询问两指间是否有材料。持物后沿用本次抓取绑定的永久 ID 并建立 attachment。空抓进入恢复，证据缺失保留待定。",
  "requires": {
    "lifted": true,
    "verified": false
  },
  "provides": [
    "verified"
  ],
  "inputs": [
    "target_id",
    "arm",
    "grasp_execution",
    "post_lift_gripper_feedback",
    "executing_wrist_rgb_if_fully_closed"
  ],
  "capability": "Verify holding and inherit the uninterrupted grasp target",
  "outputs": [
    "verified",
    "holding_presence",
    "identity_binding",
    "target_identity_outcome",
    "verification_steps",
    "execution_or_evidence_record"
  ],
  "errors": [
    "unknown_or_unbound_entity",
    "stale_generation_or_observation",
    "precondition_not_satisfied",
    "missing_measurement_or_evidence",
    "service_or_execution_failure"
  ],
  "invalidates_observation": false,
  "planning_effects": {
    "grasp_held": true,
    "grasp_completed": true,
    "attached": true,
    "recovery_needed": false
  },
  "captures_observation": true,
  "failure_effects": {
    "recovery_needed": true,
    "grasp_held": false,
    "verified": false
  }
}
