{
  "id": "verify_place",
  "description": "verify_place 沿用 verify_grasp 的持物与目标身份记录，默认搬运中持续持物，不新增搬运中核验。释放后先读实际关节位置：全开为空爪，中间位置仍持物；仅全闭时调用 object_held 判断。确认空爪后，place_result 在 direct_success、inferred_success、failure、unknown 中选择。桌面与入盒统一验收实际到达配置释放 XYZ 并张开夹爪；控制台小方框只约束机器人释放位置，不要求物体最终落点位于小方框内。直接确认表示看见物体放在指定桌面支撑或进入指定盒子。推测成功要求已确认持有目标、实际到达配置释放 XYZ（现有位置容差 5 mm）并释放、当前空爪，且没有交付失败的可见反证，不要求一定被遮挡。命令发出不等于实际到达；缺失绑定证据为 unknown，明确落在目的地外为 failure。当前三相机 RGB、释放前 RGB 与日期身份参考用于放置结果题，不投影释放小方框作为视觉验收边界。盒内同形物体不要求区分新旧，可依据执行证据选择推测成功。保留原始回答、执行推定身份、placement_outcome 与回执；推测入盒不伪造个体当前位姿，confidence 仅归档。",
  "requires": {
    "needs_place": true,
    "released": true,
    "place_execution_completed": true,
    "place_verification_completed": false
  },
  "provides": [
    "place_verification_completed"
  ],
  "inputs": [
    "original_release_binding",
    "current_post_release_rgb",
    "target_id",
    "destination_id",
    "initial_visual_reference",
    "placement_zone",
    "same_capture_gripper_feedback"
  ],
  "capability": "Visual empty-gripper check and four-way placement outcome",
  "outputs": [
    "place_verification_completed",
    "execution_or_evidence_record",
    "table_release_verified",
    "scene_available",
    "observation_motion_scene_ready",
    "placement_outcome"
  ],
  "errors": [
    "unknown_or_unbound_entity",
    "stale_generation_or_observation",
    "precondition_not_satisfied",
    "missing_measurement_or_evidence",
    "service_or_execution_failure",
    "visual_destination_unconfirmed",
    "visual_placement_rejected",
    "release_verification_binding_changed",
    "container_entry_receipt_binding_changed",
    "container_occupancy_publication_mismatch",
    "release_verification_mode_mismatch"
  ],
  "invalidates_observation": false,
  "planning_effects": {
    "table_release_verified": null
  },
  "retry_safe": true,
  "argument_rules": [
    {
      "when_arguments": {
        "release_mode": "surface_setdown"
      },
      "requires": {
        "container_release_mode": false
      },
      "effects": {}
    },
    {
      "when_arguments": {
        "release_mode": "container_release"
      },
      "requires": {
        "container_release_mode": true
      },
      "effects": {
        "scene_available": null,
        "observation_motion_scene_ready": null
      }
    }
  ],
  "captures_observation": true
}
