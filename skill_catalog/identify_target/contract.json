{
  "id": "identify_target",
  "description": "Bind the selected permanent instance with current associated geometry. Reuse verified current support or a uniquely measured numerical support. If support remains unresolved, ask one original-RGB/separate-mask choice among the current supports; do not run a predicate followed by another choice. Return unknown or rejected explicitly. New observation invalidates current support proof until re-established. No motion or capture.",
  "requires": {
    "observed": true,
    "recovery_needed": false,
    "grasp_held": false
  },
  "provides": [
    "target_selected",
    "source_support_current"
  ],
  "inputs": [
    "target_id",
    "current_observation",
    "task_bindings"
  ],
  "capability": "Bind the selected permanent instance with current associated geometry",
  "outputs": [
    "target_selected",
    "execution_or_evidence_record",
    "target_id"
  ],
  "errors": [
    "unknown_or_unbound_entity",
    "stale_generation_or_observation",
    "precondition_not_satisfied",
    "missing_measurement_or_evidence",
    "service_or_execution_failure",
    "observed_support_unknown",
    "observed_support_rejected",
    "observed_support_current_geometry_required",
    "observed_instance_missing_or_ambiguous"
  ],
  "invalidates_observation": false,
  "planning_effects": {
    "destination_selected": false,
    "destination_ready": false,
    "arm_selected": null,
    "arms_evaluated": false,
    "scene_ready": false,
    "views_ready": null,
    "grasps_ready": false,
    "plan_ready": false,
    "place_plan_ready": false,
    "place_execution_completed": false,
    "place_verification_completed": false,
    "grasp_completed": false,
    "verified": false,
    "lifted": false,
    "released": false,
    "transport_plan_ready": false,
    "transport_execution_completed": false,
    "drop_completed": false,
    "table_release_verified": false,
    "vla_pose_ready": false,
    "unpack_pending": false,
    "unpack_verified": null,
    "cycle_completed": false,
    "destination_is_container": false,
    "placement_zone_ready": false,
    "same_arm_transfer_ready": false
  },
  "retry_safe": true,
  "result_bindings": {
    "$current": "target_id"
  },
  "captures_observation": false
}
