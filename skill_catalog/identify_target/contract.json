    "grasps_ready": false,
    "plan_ready": false,
    "place_plan_ready": false,
    "place_execution_completed": false,
    "place_verification_completed": false,
    "grasp_completed": false,
    "verified": false,
    "lifted": false,
    "released": false,
    "transport_plan_ready": false,
    "transport_execution_completed": false,
    "drop_completed": false,
    "table_release_verified": false,
    "vla_pose_ready": false,
    "unpack_pending": false,
    "unpack_verified": null,
    "cycle_completed": false,
    "destination_is_container": false,
    "placement_resolved": false,
    "placement_zone_ready": false
  }
}
