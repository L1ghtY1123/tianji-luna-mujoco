{
  "id": "select_target",
  "description": "Select an observed, registered, unfinished task input. Retain explicit role IDs and the user's explicit sequence. Decisions chooses spatial order from current labelled images and base coordinates, or compares accessibility when order is free. Missing comparison evidence yields unknown. Track verified completions for all, count and individual tasks.",
  "capability": "Query current database-backed, observed, unfinished task inputs",
  "requires": {
    "observed": true,
    "grasp_held": false,
    "recovery_needed": false,
    "task_grounded": true
  },
  "provides": [],
  "inputs": [
    "task_spec",
    "current_observation",
    "operation_history"
  ],
  "outputs": [
    "selected_id",
    "observation_id"
  ],
  "outcomes": [
    "success",
    "empty",
    "unknown",
    "failure"
  ],
  "result_bindings": {
    "$selected": "selected_id"
  },
  "invalidates_observation": false,
  "retry_safe": true,
  "errors": [
    "selected_input_unfinished",
    "target_identity_unresolved",
    "target_selection_unknown",
    "remaining_input_unlocalized",
    "source_objects_unknown"
  ],
