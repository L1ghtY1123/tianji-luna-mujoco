{
  "id": "select_target",
  "description": "Query current database-backed, observed, unfinished task inputs. Unless the user explicitly orders them, ask one Decisions choice for an easier next grasp using original RGB and optional separate identity masks. Prefer exposed contact surfaces and less obstruction; choose again after each completed object. A sole candidate needs no model choice. Preserve all/count/ids obligations and do not treat an empty candidate query as task success.",
  "capability": "Query current database-backed, observed, unfinished task inputs",
  "requires": {
    "observed": true,
    "grasp_held": false,
    "recovery_needed": false
  },
  "provides": [],
  "inputs": [
    "task_spec",
    "current_observation",
    "operation_history"
  ],
  "outputs": [
    "selected_id",
    "observation_id"
  ],
  "outcomes": [
    "success",
    "empty",
    "unknown",
    "failure"
  ],
  "result_bindings": {
    "$selected": "selected_id"
  },
  "invalidates_observation": false,
  "retry_safe": true,
  "errors": [
    "selected_input_unfinished",
    "target_identity_unresolved",
    "target_selection_unknown",
    "remaining_input_unlocalized",
    "source_objects_unknown"
  ],
