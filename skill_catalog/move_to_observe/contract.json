{
  "id": "move_to_observe",
  "description": "Explicitly plan and execute a configured observation pose or declared wrist alternative. For recovery the program must find missing current identity/geometry/image evidence, confirmed empty hands and a genuinely different pose. Failure/low probability alone is insufficient. All world/self collision, map freshness and execution feedback checks remain required. The graph owns subsequent observation.",
  "inputs": [
    "current_robot_feedback",
    "latest_collision_scene",
    "configured_observation_poses",
    "planning_settings"
  ],
  "requires": {
    "scene_available": true,
    "observation_motion_scene_ready": true,
    "grasp_held": false
  },
  "provides": [
    "observation_pose_ready",
    "grasp_view_ready"
  ],
  "capability": "Explicitly plan and execute a configured observation pose or declared wrist alternative",
  "outputs": [
    "observation_pose_ready",
    "grasp_view_ready",
    "execution_or_evidence_record"
  ],
  "errors": [
    "unknown_or_unbound_entity",
    "stale_generation_or_observation",
    "precondition_not_satisfied",
    "missing_measurement_or_evidence",
    "service_or_execution_failure",
    "viewpoint_requires_visual_limitation",
    "observation_release_evidence_insufficient"
  ],
  "invalidates_observation": true,
  "planning_effects": {
    "observation_motion_scene_ready": false,
    "observed": false,
    "at_initial_pose": false
  },
  "argument_rules": [
    {
      "when_arguments": {
        "viewpoint": "configured"
      },
      "requires": {},
      "effects": {
        "observation_pose_ready": true
      }
    },
    {
      "when_arguments": {
        "viewpoint": "wrist_tilt_positive"
      },
      "requires": {},
      "effects": {
        "observation_pose_ready": false
      }
    },
    {
      "when_arguments": {
        "viewpoint": "wrist_tilt_negative"
      },
      "requires": {},
      "effects": {
        "observation_pose_ready": false
      }
    }
  ],
  "retry_safe": true,
  "captures_observation": false
}
