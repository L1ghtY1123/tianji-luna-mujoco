{
  "id": "identify_destination",
  "description": "Bind a current measured destination, fixed operator region and explicit release mode. TaskSpec final destination, work area and allowed_intermediate_refs are compiled permission; do not ask Decisions for language interpretation at runtime. Unlisted staging destinations are rejected. Preserve configured TCP XY and grasp rotation; numerical measured support provides Z. Rebinding invalidates dependent plans. Missing current destination identity can return unknown for graph-declared observation repair. Support regions require surface_setdown. Containers require container_release at the configured TCP height above the measured rim. Gentle placement on a container floor is unsupported.",
  "inputs": [
    "destination_id",
    "target_id",
    "current_observation",
    "destination_kind",
    "placement_preference",
    "orientation_mode",
    "release_mode"
  ],
  "requires": {
    "target_selected": true,
    "observed": true
  },
  "provides": [
    "destination_selected",
    "destination_ready"
  ],
  "capability": "Bind a current measured destination, fixed operator region and explicit release mode",
  "outputs": [
    "destination_selected",
    "destination_ready",
    "execution_or_evidence_record",
    "destination_id",
    "placement_preference",
    "selection_scope",
    "release_mode"
  ],
  "errors": [
    "intermediate_destination_rejected",
    "unknown_or_unbound_entity",
    "stale_generation_or_observation",
    "precondition_not_satisfied",
    "missing_measurement_or_evidence",
    "service_or_execution_failure",
    "destination_kind_mismatch",
    "container_release_requires_container",
    "observed_instance_missing_or_ambiguous",
    "container_requires_container_release"
  ],
  "invalidates_observation": false,
  "planning_effects": {
    "grasps_ready": false,
    "plan_ready": false,
    "place_plan_ready": false,
    "transport_plan_ready": false,
    "transport_execution_completed": false,
    "arm_selected": false,
    "arms_evaluated": false,
    "destination_is_container": null,
    "placement_zone_ready": false,
    "same_arm_transfer_ready": false
  },
  "argument_rules": [
    {
      "when_arguments": {
        "destination_kind": "support_region"
      },
      "requires": {},
      "effects": {
        "destination_is_container": false
      }
    },
    {
      "when_arguments": {
        "destination_kind": "container"
      },
      "requires": {},
      "effects": {
        "destination_is_container": true
      }
    },
    {
      "when_arguments": {
        "release_mode": "surface_setdown"
      },
      "requires": {},
      "effects": {
        "container_release_mode": false
      }
    },
    {
      "when_arguments": {
        "release_mode": "container_release"
      },
      "requires": {},
      "effects": {
        "container_release_mode": true
      }
    }
  ],
  "retry_safe": true,
  "captures_observation": false
}
