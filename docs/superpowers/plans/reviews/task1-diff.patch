+class Perception:
+    """Detector injection bounds network I/O; all fusion uses actual captured data."""
+
+    def __init__(self, detector=None):
+        self.detector = detector if detector is not None else Sam3Client()
+
+    def observe(self, capture, *, instruction=""):
+        _validate_capture(capture)
+        timestamp_us = round(capture["time"] * 1_000_000)
+        all_detections, table_points, views = [], [], {}
+        # Head establishes scene instances; wrists add observed surfaces.
+        for camera_id in ("3", "1", "2"):
+            view = capture["views"][camera_id]
+            detections = []
+            for kind, prompt in CLASS_PROMPTS.items():
+                for detection in self.detector.segment(view["rgb"], prompt, timestamp_us):
+                    score = float(detection["score"])
+                    if not np.isfinite(score) or not 0 <= score <= 1:
+                        raise PerceptionError("invalid detector confidence")
+                    mask = np.asarray(detection["mask"], dtype=bool)
+                    if mask.shape != view["depth_m"].shape:
+                        raise PerceptionError("sam3 mask dimensions do not match registered RGBD")
+                    points = deproject_view(view, mask)
+                    if len(points) < 30:
+                        continue
+                    measured = view["valid_depth"] & np.isfinite(view["depth_m"]) & (view["depth_m"] > 0)
+                    pixels = view["rgb"][mask & measured]
+                    color, _, _ = _color(pixels)
+                    detections.append({"mask": mask, "points": points, "pixels": pixels, "kind": kind,
+                                       "color": color, "score": score, "camera_id": camera_id})
+            # Multiple prompts can return the same official mask. Keep bin
+            # evidence until complementary views have supplied the cavity fit.
+            detections.sort(key=lambda item: (item["kind"] != "bin", -item["score"]))
+            unique = []
+            for detection in detections:
+                duplicate = False
+                for previous in unique:
+                    intersection = np.count_nonzero(detection["mask"] & previous["mask"])
+                    union = np.count_nonzero(detection["mask"] | previous["mask"])
+                    if intersection / max(union, 1) > .65:
+                        duplicate = True
+                        break
+                if not duplicate:
+                    unique.append(detection)
+            occupied = np.zeros(view["depth_m"].shape, dtype=bool)
+            for detection in unique:
+                occupied |= detection["mask"]
+            for detection in self.detector.segment(view["rgb"], "table", timestamp_us):
+                mask = np.asarray(detection["mask"], dtype=bool)
+                if mask.shape != occupied.shape:
+                    raise PerceptionError("sam3 table mask dimensions do not match registered RGBD")
+                table_points.append(deproject_view(view, mask & ~occupied))
+            all_detections.extend(unique)
+            views[camera_id] = {key: deepcopy(value) for key, value in view.items()
+                                if key not in {"rgb", "depth_m", "valid_depth"}}
+            for key in ("rgb", "depth_m", "valid_depth"):
+                views[camera_id][key] = _readonly(view[key])
+            views[camera_id]["instance_masks"] = {}
+        if not table_points:
+            raise PerceptionError("table_unobservable")
+        table = _estimate_table(np.vstack(table_points))
+        groups = []
+        for detection in all_detections:
+            candidates = []
+            for index, group in enumerate(groups):
+                if any(entry["camera_id"] == detection["camera_id"] for entry in group):
+                    continue
+                if any(_same_observed_instance(entry, detection) for entry in group):
+                    candidates.append(index)
+            if len(candidates) > 1:
+                raise PerceptionError("cross_view_instance_ambiguous")
+            if candidates:
+                groups[candidates[0]].append(detection)
+            else:
+                groups.append([detection])
+        objects = []
+        for group in groups:
+            instance = _estimate_object(group, table)
+            objects.append(instance)
+            for entry in group:
+                views[entry["camera_id"]]["instance_masks"][instance["id"]] = _readonly(entry["mask"])
+        return {"observation_id": capture["observation_id"], "generation": capture["generation"],
+                "time": capture["time"], "source": "rgbd", "objects": objects, "table": table,
+                "arms": _robot_feedback(capture["arms"]), "views": views,
+                "detector_model": deepcopy(SAM3_MODEL_IDENTITY)}
+
+    @staticmethod
+    def associate(previous, current):
+        """Old id -> current id only when every requested identity is unique.
+
+        Robot TCP displacement predicts a nearby previously held object. The
+        candidate still needs measured class, RGB feature, and size agreement.
+        """
+        if previous["generation"] != current["generation"]:
+            raise PerceptionError("instance association generation mismatch")
+        mapping = {}
+        for old in previous["objects"]:
+            expected_positions = [np.asarray(old["position"])]
+            for arm, feedback in previous.get("arms", {}).items():
+                if "tcp" not in feedback or feedback.get("gripper_closed_fraction", 0) < .2:
+                    continue
+                if arm not in current.get("arms", {}) or "tcp" not in current["arms"][arm]:
+                    continue
+                old_tcp = np.asarray(feedback["tcp"])
+                if np.linalg.norm(np.asarray(old["position"]) - old_tcp[:3, 3]) <= .2:
+                    new_tcp = np.asarray(current["arms"][arm]["tcp"])
+                    relative = np.linalg.inv(old_tcp) @ np.r_[old["position"], 1]
+                    expected_positions.append((new_tcp @ relative)[:3])
+            candidates = []
+            for new in current["objects"]:
+                if old["kind"] != new["kind"] or old["color"] != new["color"]:
+                    continue
+                if np.linalg.norm(np.asarray(old["rgb_feature"]) - np.asarray(new["rgb_feature"])) > .2:
+                    continue
+                old_size, new_size = np.asarray(old["size"]), np.asarray(new["size"])
+                if np.any(np.abs(old_size - new_size) > np.maximum(old_size * .6, .015)):
+                    continue
+                gate = max(.04, min(.12, float(np.linalg.norm(old_size))))
+                if min(np.linalg.norm(np.asarray(new["position"]) - position) for position in expected_positions) <= gate:
+                    candidates.append(new["id"])
+            if not candidates:
+                raise PerceptionError("instance association missing")
+            if len(candidates) != 1 or candidates[0] in mapping.values():
+                raise PerceptionError("instance association ambiguous")
+            mapping[old["id"]] = candidates[0]
+        return mapping
+
+
+def _robot_feedback(arms):
+    return {arm: {key: deepcopy(value) for key, value in feedback.items()
+                  if key in {"joints_rad", "tcp", "gripper_closed_fraction"}}
+            for arm, feedback in arms.items() if arm in {"A", "B"}}
+
+
+def public_observation(observation):
+    """Text-only allowlist for JEV; no RGB/depth/masks/cloud arrays or private fields."""
+    result = {key: deepcopy(observation[key]) for key in ("observation_id", "generation", "time", "source")}
+    result["arms"] = _robot_feedback(observation["arms"])
+    result["table"] = {key: deepcopy(value) for key, value in observation["table"].items()
+                       if key in {"position", "size", "surface_height_m", "uncertainty_m", "estimated", "source"}}
+    object_keys = {"id", "kind", "color", "position", "quaternion", "size", "T_world_object", "estimated",
+                   "confidence", "uncertainty_m", "source", "coverage", "cavity", "color_evidence"}
+    result["objects"] = [{key: deepcopy(value) for key, value in instance.items() if key in object_keys}
+                         for instance in observation["objects"]]
+    return result
