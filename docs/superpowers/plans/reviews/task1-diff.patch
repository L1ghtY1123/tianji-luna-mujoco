+def _same_observed_instance(first, second):
+    if first["kind"] != second["kind"] or first["color"] != second["color"]:
+        return False
+    a, b = first["points"], second["points"]
+    size_a, size_b = np.ptp(a, axis=0), np.ptp(b, axis=0)
+    gate = .02 + .5 * max(float(np.linalg.norm(size_a)), float(np.linalg.norm(size_b)))
+    if np.linalg.norm(np.median(a, axis=0) - np.median(b, axis=0)) > gate:
+        return False
+    distances = cKDTree(a).query(b)[0]
+    return float(np.median(distances)) < .015
