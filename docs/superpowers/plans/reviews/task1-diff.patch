+def test_refresh_association_is_unique_and_rejects_same_color_ambiguity_or_missing():
+    module = perception_module()
+    capture, masks = capture_fixture()
+    perception = module.Perception(FrozenSegmenter(masks))
+    previous = perception.observe(capture)
+    capture["observation_id"] = "capture-two"
+    for view in capture["views"].values():
+        view["frame_id"] = "capture-two"
+    current = perception.observe(capture)
+    mapping = perception.associate(previous, current)
+    assert set(mapping) == {obj["id"] for obj in previous["objects"]}
+    assert len(set(mapping.values())) == 2
+    ambiguous = deepcopy(current)
+    ambiguous["objects"].append({**deepcopy(current["objects"][0]), "id": "duplicate"})
+    with pytest.raises(module.PerceptionError, match="ambiguous"):
+        perception.associate(previous, ambiguous)
+    missing = {**current, "objects": current["objects"][:1]}
+    with pytest.raises(module.PerceptionError, match="missing"):
+        perception.associate(previous, missing)
+
