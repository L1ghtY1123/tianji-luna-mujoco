+def test_association_predicts_large_carried_motion_from_frozen_robot_feedback():
+    module = perception_module()
+    capture, masks = capture_fixture()
+    perception = module.Perception(FrozenSegmenter(masks))
+    old = perception.observe(capture)
+    old["objects"] = old["objects"][:1]
+    source = old["objects"][0]
+    old_tcp = np.eye(4)
+    old_tcp[:3, 3] = source["position"]
+    old["arms"]["A"].update(tcp=old_tcp.tolist(), gripper_closed_fraction=.9)
+    new = deepcopy(old)
+    new_tcp = old_tcp.copy()
+    new_tcp[:3, 3] += [.45, -.25, .2]
+    new["arms"]["A"]["tcp"] = new_tcp.tolist()
+    new["objects"][0]["position"] = (np.asarray(source["position"]) + [.45, -.25, .2]).tolist()
+    new["objects"][0]["id"] = "fresh-held-instance"
+    assert perception.associate(old, new) == {source["id"]: "fresh-held-instance"}
+
+
+def bin_cloud():
+    x, y = np.meshgrid(np.linspace(-.04, .04, 11), np.linspace(-.05, .05, 11))
+    floor = np.column_stack((x.ravel(), y.ravel(), np.full(x.size, .61)))
+    rim = []
+    for along in np.linspace(-1, 1, 31):
+        rim.extend([[along * .06, -.07, .69], [along * .06, .07, .69],
+                    [-.06, along * .07, .69], [.06, along * .07, .69]])
+    return np.vstack((floor, rim)).astype(np.float32)
+
+
+def test_bin_cavity_requires_visible_floor_and_four_sides_and_uses_floor_origin():
+    module = perception_module()
+    cavity = module.fit_bin_cavity(bin_cloud())
+    np.testing.assert_allclose(np.asarray(cavity["T_world_bin"])[:3, 3], [0., 0., .61], atol=1e-6)
+    np.testing.assert_allclose(cavity["inner_size_m"], [.08, .10, .08], atol=.004)
+    assert cavity["floor_height_m"] == pytest.approx(.61, abs=1e-6)
+    assert cavity["uncertainty_m"] > 0 and cavity["estimated"] is True
+    with pytest.raises(module.PerceptionError, match="cavity"):
+        module.fit_bin_cavity(bin_cloud()[:121])
+    hidden_side = bin_cloud()[bin_cloud()[:, 0] < .055]
+    with pytest.raises(module.PerceptionError, match="cavity"):
+        module.fit_bin_cavity(hidden_side)
+
