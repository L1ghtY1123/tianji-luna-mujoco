+// Cached sensor frames are display-only. This panel never requests scene truth
+// or starts a fresh capture, and serial polling cannot pile up render requests.
+export function createCameraPanel(container, status, {
+  document: ownerDocument = globalThis.document,
+  request,
+  schedule = globalThis.setTimeout,
+  cancel = globalThis.clearTimeout,
+  isVisible = () => ownerDocument.visibilityState !== 'hidden',
+} = {}) {
+  let running = false;
+  let timer = null;
+  let inFlight = null;
+  let generation = 0;
+  let observationId = null;
+
+  function element(tag, className, text) {
+    const node = ownerDocument.createElement(tag);
+    if (className) node.className = className;
+    if (text !== undefined) node.textContent = text;
+    return node;
+  }
+
+  function next(delay = 2000) {
+    if (!running) return;
+    if (timer !== null) cancel(timer);
+    timer = schedule(() => { timer = null; void refresh(); }, delay);
+  }
+
+  function render(payload) {
+    if (!Number.isInteger(payload?.generation) || !Array.isArray(payload.cameras)) throw new Error('相机响应结构不完整。');
+    if (payload.generation < generation) return;
+    if (!payload.cameras.length) {
+      container.replaceChildren();
+      observationId = null;
+      status.textContent = '等待三路 RGBD 相机采集。';
+      return;
+    }
+    if (payload.cameras.length !== 3 || !payload.observation_id || !Number.isFinite(payload.time)) throw new Error('三路相机捕获信息不完整。');
+    const ids = new Set();
+    for (const camera of payload.cameras) {
+      const id = String(camera.id);
+      if (!['1', '2', '3'].includes(id) || ids.has(id) || typeof camera.frame_id !== 'string' || !camera.frame_id) throw new Error('相机帧标识无效。');
+      ids.add(id);
+      if (camera.rgb_url !== `/api/cameras/${id}/rgb` || camera.depth_url !== `/api/cameras/${id}/depth`) throw new Error('相机预览地址无效。');
+    }
+    if (payload.observation_id === observationId && payload.generation === generation) return;
+    const cards = payload.cameras.map(camera => {
+      const card = element('article', 'camera-card');
+      card.append(element('h3', '', camera.label ?? `相机 ${camera.id}`));
+      const images = element('div', 'camera-images');
+      for (const [kind, label] of [['rgb', 'RGB'], ['depth', '深度伪彩']]) {
+        const figure = element('figure');
+        const image = element('img');
+        image.src = `${camera[`${kind}_url`]}?frame_id=${encodeURIComponent(camera.frame_id)}`;
+        image.alt = `${camera.label ?? `相机 ${camera.id}`} ${label}`;
+        image.decoding = 'async';
+        figure.append(image, element('figcaption', '', label));
+        images.append(figure);
+      }
+      card.append(images, element('p', 'camera-frame', `帧 ${camera.frame_id}`));
+      return card;
+    });
+    container.replaceChildren(...cards);
+    generation = payload.generation;
+    observationId = payload.observation_id;
+    status.textContent = `观测 ${observationId} · 场景 ${generation} · 仿真时间 ${payload.time.toFixed(2)} s`;
+  }
+
+  function refresh() {
+    if (inFlight) return inFlight;
+    if (timer !== null) { cancel(timer); timer = null; }
+    if (!isVisible()) { next(); return Promise.resolve(); }
+    inFlight = (async () => {
+      try { render(await request('/api/cameras')); }
+      catch (error) { status.textContent = `相机预览读取失败：${error.message}`; }
+      finally { inFlight = null; next(); }
+    })();
+    return inFlight;
+  }
+
+  return {
+    refresh,
+    start() { if (!running) { running = true; next(0); } },
+    stop() { running = false; if (timer !== null) { cancel(timer); timer = null; } },
+    setGeneration(value) {
+      if (Number.isInteger(value) && value > generation) {
+        generation = value;
+        observationId = null;
+        container.replaceChildren();
+        status.textContent = '等待当前场景的三路 RGBD 相机采集。';
+      }
+    },
+  };
+}
