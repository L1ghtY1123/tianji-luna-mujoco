# Official gpt-6-luna configuration is mounted read-only from outside this project.
# No TypeSafe/JEV key is used by the demo.
LUNA_DECISIONS_TIMEOUT_S=90
LUNA_GRASPGEN_URL=http://127.0.0.1:8363
LUNA_CUROBO_URL=http://127.0.0.1:8352
# Backend address reachable from Luna; browser address may use an SSH tunnel.
LUNA_BASE_URL=http://127.0.0.1:8000
LUNA_BASE_PUBLIC_URL=http://127.0.0.1:8000
# Optional scene origin; empty derives http://<Base robot_ip>:8767. Host must match robot_ip.
LUNA_SIMULATION_SCENE_URL=
LUNA_SAM3_URL=http://127.0.0.1:8362
LUNA_EXPERIMENT_DIR=/opt/jev/data/experiments
