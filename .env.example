TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-1.13.0
JEV_MINIMUM_CONFIDENCE=0.6
JEV_GRASPGEN_URL=http://127.0.0.1:8323
JEV_CUROBO_URL=http://127.0.0.1:8310
JEV_SAM3_URL=http://127.0.0.1:8322
JEV_PLAN_TIMEOUT_S=180
JEV_EXPERIMENT_DIR=/home/guangyu/projects/tianji-experiments

# Visual inventory uses official Responses (initial RGB discovery) and Decisions (identity/progress).
# Store {"api_key": "..."} outside the repository with owner-only permissions.
# Compose uses /opt/jev/openai-config/decisions.json through the existing read-only mount.
# Local override: JEV_DECISIONS_CONFIG_FILE or JEV_DECISIONS_API_KEY.
JEV_DECISIONS_TIMEOUT_S=60

# Legacy injected adapters only; unrelated third-party Responses configuration.
JEV_VISUAL_ASSISTANCE_ENABLED=false
JEV_VISION_MODEL=
JEV_VISUAL_TIMEOUT_S=90
